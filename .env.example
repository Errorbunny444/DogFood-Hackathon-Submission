# ==============================================================================
# DOGFOOD 2026 Production & Self-Hosted Configuration
# Copy this file to .env and adjust variables for your target deployment mode.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION OPERATING MODE (Section 2, 76)
# Options:
#   demo       - Zero external setup, in-memory DB or local storage, fixture data, persona switcher.
#   selfhosted - Real user accounts, organizations, events, local/S3 storage, SMTP, no persona switcher.
#   cloud      - Multi-tenant hosted SaaS, strict external DB, object storage, transactional email.
# ------------------------------------------------------------------------------
APP_MODE=selfhosted

# ------------------------------------------------------------------------------
# 2. RUNTIME ENVIRONMENT & NETWORK (Section 31)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=8080
HOST=0.0.0.0
APP_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:8080
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 3. AUTHORITATIVE DATABASE (Section 62)
# Authoritative PostgreSQL relational database connection URL.
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://dogfood:dogfood@db:5432/dogfood

# ------------------------------------------------------------------------------
# 4. SESSIONS & COOKIE SECURITY (Section 4, 39)
# Provide a cryptographically random string (min 32 characters) for cookie signing.
# ------------------------------------------------------------------------------
SESSION_SECRET=change_me_to_a_random_32_character_secret_key_in_production
SESSION_COOKIE_NAME=session
SESSION_DURATION_DAYS=30

# ------------------------------------------------------------------------------
# 5. STORAGE PROVIDER ABSTRACTION (Section 15)
# Options:
#   local - Stores uploads on the persistent container/host filesystem.
#   s3    - Compatible with AWS S3, Cloudflare R2, MinIO, Wasabi.
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=uploads

# S3-compatible configuration (Required if STORAGE_PROVIDER=s3)
# S3_BUCKET=dogfood-production-assets
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=your_access_key_id
# S3_SECRET_ACCESS_KEY=your_secret_access_key

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAIL SYSTEM (Section 13)
# Options:
#   console - Prints formatted emails to stdout / memory (zero setup, demo & testing).
#   smtp    - Standard SMTP mailer for self-hosted mail servers (e.g. Mailgun, Sendgrid, Postmark).
#   resend  - Modern transactional email provider API.
# ------------------------------------------------------------------------------
EMAIL_PROVIDER=console
EMAIL_FROM="DOGFOOD 2026 <noreply@dogfood.local>"

# SMTP Configuration (Required if EMAIL_PROVIDER=smtp)
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@yourdomain.com
# SMTP_PASS=your_smtp_password
# SMTP_SECURE=false

# Resend Configuration (Required if EMAIL_PROVIDER=resend)
# RESEND_API_KEY=re_123456789

# ------------------------------------------------------------------------------
# 7. BACKGROUND WORKERS & SCHEDULER (Section 14, 63)
# Set to 'true' to run the worker in-process, or 'false' if running separate worker process.
# ------------------------------------------------------------------------------
JOB_WORKER_ENABLED=true

# ------------------------------------------------------------------------------
# 8. DEMO DATA SEEDING (Section 77)
# Automatically seeds fixture projects, judges, and acceptance sessions.
# MUST be false in production and cloud environments.
# ------------------------------------------------------------------------------
SEED_DEMO_DATA=false

# ------------------------------------------------------------------------------
# 9. OBSERVABILITY & ERROR REPORTING (Section 35, 36)
# Optional Sentry DSN for remote error reporting. Defaults to structured console logs.
# ------------------------------------------------------------------------------
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
